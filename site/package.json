{
    "name": "minisago-website",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check": "tsc -p tsconfig.json --noEmit && eslint . && prettier . --check && next build"
    },
    "dependencies": {
        "lucide-react": "1.17.0",
        "next": "16.4.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@next/eslint-plugin-next": "16.4.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "complete-lint": "5.12.0",
        "eslint": "10.4.1",
        "eslint-config-complete": "4.8.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "prettier": "3.8.3",
        "typescript": "6.0.3"
    },
    "packageManager": "npm@11",
    "engines": {
        "node": ">=22"
    }
}
