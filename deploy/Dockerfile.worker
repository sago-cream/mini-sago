FROM oven/bun:1.3.9-debian AS runtime

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends --reinstall ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    file \
    gh \
    git \
    jpegoptim \
    jq \
    libimage-exiftool-perl \
    openssh-client \
    optipng \
    python3 \
    python3-venv \
    ripgrep \
    webp \
  && rm -rf /var/lib/apt/lists/* \
  && ln -s /usr/local/bin/bun /usr/local/bin/node \
  && git config --system user.name Hsi \
  && git config --system user.email 94444077+sago-cream@users.noreply.github.com \
  && git config --system credential.https://github.com.helper '!/usr/bin/gh auth git-credential'

COPY scripts/install-gh-image.py /tmp/install-gh-image.py
RUN python3 /tmp/install-gh-image.py "$(dpkg --print-architecture)" \
  && gh-image --version \
  && rm /tmp/install-gh-image.py

ARG CODEX_VERSION=0.160.0
RUN BUN_INSTALL=/usr/local bun add --cafile=/etc/ssl/certs/ca-certificates.crt --global "@openai/codex@${CODEX_VERSION}" \
  && codex --version

FROM runtime AS worker

WORKDIR /app/worker

COPY --chown=bun:bun worker/package.json worker/bun.lock ./
RUN bun install --cafile=/etc/ssl/certs/ca-certificates.crt --frozen-lockfile --production

COPY worker/requirements-sandbox.txt ./requirements-sandbox.txt
RUN python3 -m venv /opt/minisago-python \
  && /opt/minisago-python/bin/pip install --no-cache-dir \
    'pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70' \
  && /opt/minisago-python/bin/pip install --no-cache-dir 'certifi>=2026.10.19' -r requirements-sandbox.txt
RUN mkdir -p /opt/minisago-models /opt/minisago-numba-cache \
  && U2NET_HOME=/opt/minisago-models NUMBA_CACHE_DIR=/opt/minisago-numba-cache /opt/minisago-python/bin/python -c 'from PIL import Image; from rembg import new_session, remove; remove(Image.new("RGB", (64, 64), "white"), session=new_session("u2netp"))'
RUN chmod -R a+rX /opt/minisago-python /opt/minisago-models /opt/minisago-numba-cache

COPY --chown=bun:bun src/chatbot /app/src/chatbot
COPY --chown=bun:bun src/observability /app/src/observability
COPY --chown=bun:bun contracts /app/contracts
COPY --chown=bun:bun scripts/deploy-socket.ts /app/scripts/deploy-socket.ts
COPY --chown=bun:bun worker/src ./src
COPY --chown=bun:bun worker/tsconfig.json ./tsconfig.json
COPY --chmod=755 scripts/worker-entrypoint.sh /usr/local/bin/worker-entrypoint

RUN mkdir -p /home/bun/.codex /home/bun/.config/gh /var/lib/minisago /workspace/worktrees \
  && chown -R bun:bun /home/bun/.codex /home/bun/.config /var/lib/minisago /workspace \
  && chmod 700 /home/bun/.config/gh /workspace /workspace/worktrees

ENV MINISAGO_HEADLESS=true
ENV HOME=/home/bun
ENV MINISAGO_CODEX_HOME=/home/bun/.codex
ENV MINISAGO_CODEX_PATH=/usr/local/bin/codex
ENV MINISAGO_TRACE_DATABASE_PATH=/var/lib/minisago/traces.sqlite
ENV MINISAGO_WORKSPACE_ROOT=/workspace
ENV MINISAGO_GITHUB_WORKTREE_ROOT=/workspace/worktrees
ENV MINISAGO_GITHUB_CONFIG_DIR=/home/bun/.config/gh
ENV MINISAGO_MAX_CONCURRENT_JOBS=2
ENV MINISAGO_WORKER_ID=oracle
ENV MINISAGO_SANDBOX_URL=http://sandbox:8080

ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
CMD ["bun", "src/index.ts"]
